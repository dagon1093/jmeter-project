# --- JMeter runtime артефакты ---
jmeter.log
*/jmeter.log
*.jtl
*.jtl.gz
*.sav         # времянки GUI (если включены)
*.bak
*.tmp
*.swp
*~            # backup-файлы редакторов

# --- Результаты прогонов и HTML-дашборды ---
/results/**
/reports/**
!/results/.gitkeep
!/reports/.gitkeep
/logs/**

# --- Генерируемые тестовые данные ---
/data/generated/**
*.out
*.err
/pools/**
*.csv

# --- Локальные/секретные конфиги ---
/config/**/secrets*.properties
/config/**/secrets*.yml
/config/**/secrets*.yaml
/config/**/local.properties
/config/**/.env
/config/.env
*.env
.env*

# --- Плагины (опционально) ---
# Если тащишь плагины/джары через пакетный менеджер — игнорируй кэш/загрузки.
# Оставь закомментировано, если хранишь нужные .jar в репо намеренно.
# /lib/plugins/**
# /lib/downloads/**

# --- IDE/OS мусор ---
.idea/
.vscode/
*.iml
*.code-workspace
.DS_Store
Thumbs.db

# --- Docker (опционально) ---
docker-compose.override.yml
**/docker-data/**